// Prisma Schema for Foot360 European Football News & Multi-Agent Intelligence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Author {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  avatar        String
  role          String   // e.g. "Senior Premier League Analyst", "Tactical Correspondent"
  bio           String
  credentials   String   // E-E-A-T background, accreditation, UEFA coaching license, etc.
  twitterHandle String?
  posts         Post[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model League {
  id           String          @id @default(cuid())
  name         String          // e.g. Premier League, La Liga
  slug         String          @unique // premier-league, la-liga, etc.
  country      String          // England, Spain, Germany, Italy, France, Europe
  tier         Int             @default(1)
  logo         String
  badgeColor   String          @default("#10b981")
  teams        Team[]
  matches      Match[]
  posts        Post[]
  transfers    TransferRumor[]
  createdAt    DateTime        @default(now())
}

model Team {
  id           String          @id @default(cuid())
  name         String
  shortName    String
  slug         String          @unique
  badgeUrl     String
  stadium      String
  foundedYear  Int?
  leagueId     String
  league       League          @relation(fields: [leagueId], references: [id])
  homeMatches  Match[]         @relation("HomeTeam")
  awayMatches  Match[]         @relation("AwayTeam")
  createdAt    DateTime        @default(now())
}

model Match {
  id           String   @id @default(cuid())
  leagueId     String
  league       League   @relation(fields: [leagueId], references: [id])
  homeTeamId   String
  homeTeam     Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchDate    DateTime
  status       String   // SCHEDULED, LIVE, FT, POSTPONED
  minute       Int?     // Current match minute if live
  homeScore    Int      @default(0)
  awayScore    Int      @default(0)
  venue        String
  statsJson    String?  // JSON string of xG, possession, shots, lineups
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  excerpt          String
  content          String   // Full 500-700 word journalistic story
  coverImage       String
  category         String   // MATCH_REPORT, TACTICAL_ANALYSIS, TRANSFER_RADAR, BREAKING_NEWS
  leagueId         String?
  league           League?  @relation(fields: [leagueId], references: [id])
  authorId         String
  author           Author   @relation(fields: [authorId], references: [id])
  tacticalAnalysis String?  // Specific formation / tactical insights
  statsBreakdown   String?  // JSON string of advanced metrics / stats
  sources          String   // JSON string of verified sources & quotes with attribution
  rumorTier        Int?     // 1 to 4 if transfer/rumor news
  seoTitle         String
  seoDescription   String
  keywords         String   // Comma-separated GEO & SEO tags
  schemaJson       String   // JSON-LD NewsArticle / SportsEvent string
  isCompliant      Boolean  @default(true) // Google AdSense & E-E-A-T checked
  complianceScore  Int      @default(95)   // Compliance rating (0-100)
  views            Int      @default(0)
  featured         Boolean  @default(false)
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TransferRumor {
  id              String   @id @default(cuid())
  playerName      String
  currentClub     String
  targetClub      String
  position        String
  transferFee     String   // e.g. "€75M + Add-ons"
  rumorTier       Int      // 1: Done Deal/Tier 1, 2: Advanced Talks, 3: Emerging Interest, 4: Speculation
  confidenceScore Int      // 0 - 100%
  sourceName      String   // e.g. "Fabrizio Romano", "David Ornstein", "The Athletic"
  sourceUrl       String?
  leagueId        String?
  league          League?  @relation(fields: [leagueId], references: [id])
  summary         String
  verifiedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgentLog {
  id          String   @id @default(cuid())
  agentName   String   // Scout, FactChecker, SportsReporter, SEO_GEO_Expert, ComplianceEditor, Orchestrator
  action      String   // Ingest, Verify, Write, Optimize, Audit
  status      String   // SUCCESS, WARNING, FAILED
  details     String   // JSON or text logs
  createdAt   DateTime @default(now())
}
